{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naver-mail-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: 주소형 Client ID(CIMD, Claude 등)를 읽을 때 라이브러리가 요구한다
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "NaverMailMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NaverMailMcp"] }],
  // OAuth 클라이언트·토큰 저장소. Deploy to Cloudflare 버튼은 새로 만들어 id를 바꿔 넣는다. 직접 배포할 때는 `npx wrangler kv namespace create OAUTH_KV`로 만든 id로 바꾼다
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "db247ed018324f959c33b75da64d0cb9" }],
  "vars": {
    // 쉼표로 구분한 네이버 아이디. 비우면 누구나 자기 계정으로 연결 가능
    "ALLOWED_USERS": "",
    "SAVE_SENT_COPY": "true"
  }
  // 시크릿(선택, 고정 토큰 모드): wrangler secret put MCP_BEARER_TOKEN / NAVER_ID / NAVER_APP_PASSWORD
}
